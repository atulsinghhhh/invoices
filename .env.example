# Database Configuration
# The PostgreSQL connection URL. Since the project includes a docker-compose.yaml with PostgreSQL
# running on port 5432, with user 'postgres', password 'postgres', and database 'invoice_db',
# the default URL is:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoice_db?schema=public"

# NextAuth Configuration
# A random secret key for NextAuth. You can generate a strong secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Configuration (Optional, required for Google sign-in)
# Obtain these from the Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
